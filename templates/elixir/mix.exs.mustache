defmodule {{moduleName}}.Mixfile do
  use Mix.Project

  def project do
    [
      app: {{#atom}}{{#underscored}}{{packageName}}{{/underscored}}{{/atom}},
{{#devBranch}}
      version: "{{packageVersion}}-dev",
{{/devBranch}}
{{^devBranch}}
      version: "{{packageVersion}}",
{{/devBranch}}
      elixir: "~> {{supportedElixirVersion}}",
      build_embedded: Mix.env() == :prod,
      start_permanent: Mix.env() == :prod,
      package: package(),
      description: """
      {{appDescription}}
      """,
      deps: deps()
    ]
  end

  # Configuration for the OTP application
  #
  # Type "mix help compile.app" for more information
  def application do
    # Specify extra applications you'll use from Erlang/Elixir
    [extra_applications: [{{extraApplications}}, :inets, :ssl]]
  end

  # Dependencies can be Hex packages:
  #
  #   {:my_dep, "~> 0.3.0"}
  #
  # Or git/path repositories:
  #
  #   {:my_dep, git: "https://github.com/elixir-lang/my_dep.git", tag: "0.3.0"}
  #
  # Type "mix help deps" for more examples and options
  defp deps do
    [
{{#deps}}
      {{{this}}}{{^-last}},{{/-last}}
{{/deps}}
    ]
  end

  defp package do
    [
      name: "{{#underscored}}{{packageName}}{{/underscored}}",
      files: ~w(.formatter.exs config lib mix.exs README* LICENSE*),
      licenses: ["{{#licenseId}}{{licenseId}}{{/licenseId}}{{^licenseId}}MIT{{/licenseId}}"],
      links: %{"GitHub" => "https://github.com/{{gitUserId}}/{{gitRepoId}}"}
    ]
  end
end
